{
  "id": "neon-clock",
  "name": "Neon Clock",
  "version": "1.0.0",
  "author": "Deskforge",
  "description": "An analog clock ringed by your music. The ring pulses on every beat.",
  "type": "widget",
  "entry": "index.html",
  "permissions": ["audio"],
  "size": { "w": 20, "h": 36 },
  "settings": [
    { "key": "color", "label": "Color", "type": "color", "default": "#ffb36b" },
    { "key": "seconds", "label": "Show seconds hand", "type": "toggle", "default": true },
    { "key": "reactivity", "label": "Music reactivity", "type": "number", "default": 1, "min": 0, "max": 3, "step": 0.1 }
  ]
}
