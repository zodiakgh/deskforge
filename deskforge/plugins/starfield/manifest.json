{
  "id": "starfield",
  "name": "Starfield",
  "version": "1.0.0",
  "author": "Deskforge",
  "description": "A drifting starfield. Stars speed up with the bass of your music.",
  "type": "wallpaper",
  "entry": "index.html",
  "permissions": ["audio"],
  "settings": [
    { "key": "color", "label": "Star color", "type": "color", "default": "#cfe0ff" },
    { "key": "count", "label": "Star count", "type": "number", "default": 420, "min": 50, "max": 1500, "step": 10 },
    { "key": "speed", "label": "Base speed", "type": "number", "default": 1, "min": 0.1, "max": 4, "step": 0.1 }
  ]
}
